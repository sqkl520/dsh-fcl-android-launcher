<?xml version="1.0" encoding="utf-8"?>
<!--
  dsh 启动器主外壳 —— 骨架**逐部件照搬** FCL 的 activity_main.xml：
    background(根) / video_view / left_menu / right_menu / ui_layout / title
  只把菜单项与右侧面板的内容换成 dsh 的（见 docs/design/app-shell.md §4.1）。
  与 FCL 保持一致的细节：左侧菜单 bg_game_menu + elevation 100dp + padding 5/10/5/10；
  右侧面板 bg_right_menu + 宽度 25% + elevation 100dp + 内层 right_menu_content；
  动态岛在**底部居中**（FCL 原位）；ViewPager2 高度 match_parent 且无额外边距。
  视觉全部走 fcllibrary 控件 + ThemeEngine（§2.5）。
  菜单项：实例 / 版本 / 设置 + 返回（管理是零引用的空占位、日志拆进实例详情与设置子页，故删）。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:transitionName="background"
    tools:context=".ui.shell.DshMainActivity">

    <!-- 动态壁纸（FCL 同款：可选，放 filesDir 下的 live.mp4 才显示） -->
    <VideoView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ===== 左侧滑出菜单（FCL 同款：半透明底 + 100dp 抬升 + 10dp 内边距） ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/left_menu"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:background="@drawable/bg_game_menu"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="100dp"
        android:paddingStart="5dp"
        android:paddingTop="10dp"
        android:paddingEnd="5dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 菜单项自上而下一条竖链，每项 bottom→下一项、top→上一项。
             删掉「管理」「日志」两项后这条链必须重连：instances↔versions↔setting↔back，
             断链会让整条菜单叠在一起或整条消失（ConstraintLayout 无约束时按 0,0 摆放）。 -->
        <com.tungsten.fcllibrary.component.view.FCLMenuView
            android:id="@+id/instances"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_dsh_instances_24"
            app:layout_constraintBottom_toTopOf="@id/versions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.tungsten.fcllibrary.component.view.FCLMenuView
            android:id="@+id/versions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_baseline_download_24"
            app:layout_constraintBottom_toTopOf="@id/setting"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/instances" />

        <com.tungsten.fcllibrary.component.view.FCLMenuView
            android:id="@+id/setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_dsh_settings_24"
            app:layout_constraintBottom_toTopOf="@id/back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/versions" />

        <!-- FCL 的返回项：与 §4.2 的映射一致，保留 -->
        <com.tungsten.fcllibrary.component.view.FCLMenuView
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_baseline_arrow_back_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/setting" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===== 右侧面板（FCL 同款：25% 宽、半透明底、100dp 抬升、内层 content） ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/right_menu"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_right_menu"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.25">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/right_menu_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.tungsten.fcllibrary.component.view.FCLTextView
                android:id="@+id/right_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:singleLine="true"
                android:text="@string/dsh_right_current_instance"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:use_theme_color="true" />

            <com.tungsten.fcllibrary.component.view.FCLTextView
                android:id="@+id/right_instance_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/right_title"
                app:use_theme_color="true"
                tools:text="dsh 0.1.5-rc.2" />

            <com.tungsten.fcllibrary.component.view.FCLTextView
                android:id="@+id/right_instance_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/right_instance_name"
                app:use_theme_color="true"
                tools:text="就绪 · 端口 3080" />

                    <!-- 启动 / 停止 —— 照 FCL activity_main.xml 的 start 按钮形态：
                 无边框 clickable 容器 + 按压缩放（anim_scale）+ 图标与文字居中成链，
                 图标用 FCLImageView + background + use_theme_color，文字 use_theme_color -->
            <com.tungsten.fcllibrary.component.view.FCLConstraintLayout
                android:id="@+id/right_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:elevation="200dp"
                android:focusable="true"
                android:paddingVertical="10dp"
                android:stateListAnimator="@xml/anim_scale"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/right_instance_hint">

                <com.tungsten.fcllibrary.component.view.FCLImageView
                    android:id="@+id/right_start_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/ic_start"
                    app:layout_constraintBottom_toBottomOf="@id/right_start_text"
                    app:layout_constraintEnd_toStartOf="@id/right_start_text"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/right_start_text"
                    app:use_theme_color="true" />

                <com.tungsten.fcllibrary.component.view.FCLTextView
                    android:id="@+id/right_start_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/dsh_action_start"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/right_start_icon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:use_theme_color="true" />

            </com.tungsten.fcllibrary.component.view.FCLConstraintLayout>

            <!-- 打开界面 —— 同款形态 -->
            <com.tungsten.fcllibrary.component.view.FCLConstraintLayout
                android:id="@+id/right_webui"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:elevation="200dp"
                android:focusable="true"
                android:paddingVertical="10dp"
                android:stateListAnimator="@xml/anim_scale"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/right_start">

                <com.tungsten.fcllibrary.component.view.FCLImageView
                    android:id="@+id/right_webui_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/ic_baseline_earth_24"
                    app:layout_constraintBottom_toBottomOf="@id/right_webui_text"
                    app:layout_constraintEnd_toStartOf="@id/right_webui_text"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/right_webui_text"
                    app:use_theme_color="true" />

                <com.tungsten.fcllibrary.component.view.FCLTextView
                    android:id="@+id/right_webui_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/dsh_action_open_webui"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/right_webui_icon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:use_theme_color="true" />

            </com.tungsten.fcllibrary.component.view.FCLConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===== 内容区（夹在左菜单与右面板之间；FCL 为 match_parent 高度、无额外边距） ===== -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/ui_layout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toStartOf="@id/right_menu"
        app:layout_constraintStart_toEndOf="@id/left_menu" />

    <!-- ===== 动态岛标题（FCL 原位：底部居中 + 15dp 底边距） ===== -->
    <com.tungsten.fcllibrary.component.view.FCLDynamicIsland
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
