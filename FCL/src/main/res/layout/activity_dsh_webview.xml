<?xml version="1.0" encoding="utf-8"?>
<!-- dsh Web UI 承载页：WebView + 加载进度 + 状态面板（启动中/失败时可重试、看日志、停止）。
     改造前：URL 抓不到就是永远转圈，没有任何失败出口。
     FCL 风格（见 docs/design/app-shell.md §2.5）：按钮/文本/进度用 fcllibrary 控件。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 页面加载进度（WebChromeClient.onProgressChanged 驱动） -->
    <com.tungsten.fcllibrary.component.view.FCLProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:max="100"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/state_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_container_white"
        android:padding="24dp"
        android:visibility="gone">

        <com.tungsten.fcllibrary.component.view.FCLProgressBar
            android:id="@+id/state_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/state_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/state_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/dsh_webview_starting"
            android:textSize="14sp"
            app:auto_text_tint="true"
            app:layout_constraintBottom_toTopOf="@id/btn_row"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/state_progress" />

        <LinearLayout
            android:id="@+id/btn_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/state_text">

            <com.tungsten.fcllibrary.component.view.FCLButton
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/dsh_action_retry"
                app:ripple="true" />

            <com.tungsten.fcllibrary.component.view.FCLButton
                android:id="@+id/btn_logs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text="@string/dsh_action_logs"
                app:ripple="true" />

            <com.tungsten.fcllibrary.component.view.FCLButton
                android:id="@+id/btn_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text="@string/dsh_action_stop"
                app:ripple="true" />

        </LinearLayout>

        <!-- 返回实例列表（状态面板是唯一可见内容时，需要明确出口） -->
        <com.tungsten.fcllibrary.component.view.FCLButton
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/dsh_action_close"
            app:ripple="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>