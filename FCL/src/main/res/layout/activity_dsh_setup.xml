<?xml version="1.0" encoding="utf-8"?>
<!--
  首启「准备运行环境」页（一次性前置）。

  ★ 横屏双栏：本 App 全程锁横屏（sensorLandscape），竖排长条内容在横屏下要滚动才能看全，
    所以按 FCL 的横屏习惯做成**左右两栏** ——
      左栏：品牌 + 提示 + 主进度卡（进度/步骤/明细，信息量最大）
      右栏：准备项清单 + 操作按钮
    两栏各自高度都控制在 ~330dp 以内，横屏一屏可见，无需滚动。

  视觉：主题背景图 + 白卡片 + 主题色进度条；全部走 fcllibrary + ThemeEngine。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:transitionName="background">

    <!--
      背景图不再是一个子 ImageView，而是**直接铺在根容器上**（根就是背景承载层）：
      图片由代码 ImageUtil.loadInto(binding.background, …) 装填，随亮暗主题刷新。

      ★ 为什么这么做（原来那套"子 ImageView 铺图 + #66000000 压暗层"已整个删除）：
      · FCL 的背景写法就是"根容器持有 id=background + 代码把主题图铺上去"
        —— 启动页的 activity_splash.xml 与外壳的 activity_main.xml 都是根 ConstraintLayout 上挂
        id=background / transitionName=background，再由 ThemeEngine 给图。本页照抄同一套，
        不再自创第二层容器。
      · 压暗层是为"白字压在任意背景图上仍可读"而存在的。现在对比问题已经由 FCL 的取色体系解决：
        图上方的文字一律走 FCLTextView 的 auto_text_tint（按主题色算出的黑/白），卡片靠
        auto_tint 取主题底色。多盖一层固定半透明黑，只会让背景在亮色主题下发灰，且暗色主题下
        叠成双重变暗，属于 FCL 没有的语言。
      · 首启准备页虽然可能"用户还没配过主题"，但 ThemeData.getTheme() 对亮/暗两张背景都做了
        内置默认图兜底，所以这里一定有图可铺，不存在空白页。
    -->

    <ScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 双栏容器：宽度用 padding 限制（平板/大屏不至于拉太宽） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="56dp"
            android:paddingTop="20dp"
            android:paddingEnd="56dp"
            android:paddingBottom="20dp">

            <!-- ================= 左栏：品牌 + 主进度卡 ================= -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.tungsten.fcllibrary.component.view.FCLTextView
                    android:id="@+id/app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dsh_setup_brand"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:auto_text_tint="true" />

                <com.tungsten.fcllibrary.component.view.FCLTextView
                    android:id="@+id/app_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.85"
                    android:text="@string/dsh_about_subtitle"
                    android:textSize="12sp"
                    app:auto_text_tint="true" />

                <com.tungsten.fcllibrary.component.view.FCLTextView
                    android:id="@+id/setup_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0.7"
                    android:text="@string/dsh_setup_hint_space"
                    android:textSize="11sp"
                    app:auto_text_tint="true" />

                <!-- 主进度卡 -->
                <com.tungsten.fcllibrary.component.view.FCLConstraintLayout
                    android:id="@+id/progress_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_container_white"
                    android:padding="16dp"
                    app:auto_tint="true">

                    <!-- ★ 图标走 android:background 而不是 android:src：FCLImageView 的主题着色
                         只作用于 getBackground()，走 src 时 use_theme_color 会完全失效
                         （图标保持 vector 自带的颜色）。代码里换图同样用 setBackgroundResource。 -->
                    <com.tungsten.fcllibrary.component.view.FCLImageView
                        android:id="@+id/state_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/ic_baseline_download_24"
                        android:padding="0dp"
                        app:layout_constraintBottom_toBottomOf="@id/progress_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/progress_title"
                        app:use_theme_color="true" />

                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:id="@+id/progress_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:singleLine="true"
                        android:text="@string/dsh_setup_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:auto_text_tint="true"
                        app:layout_constraintEnd_toStartOf="@id/progress_percent"
                        app:layout_constraintStart_toEndOf="@id/state_icon"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:id="@+id/progress_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintBaseline_toBaselineOf="@id/progress_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:use_theme_color="true" />

                    <!-- 主进度用 FCL 的波浪进度条（FCL 主页的"下载进度"就是它）：0..1，负值=不确定态 -->
                    <com.mio.ui.view.WaveProgressView
                        android:id="@+id/progress_bar"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="6dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progress_title" />

                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:id="@+id/progress_stage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:maxLines="2"
                        android:textSize="13sp"
                        app:auto_text_tint="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progress_bar" />

                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:id="@+id/progress_detail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:alpha="0.6"
                        android:ellipsize="middle"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:textSize="10sp"
                        android:visibility="gone"
                        app:auto_text_tint="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progress_stage" />

                </com.tungsten.fcllibrary.component.view.FCLConstraintLayout>
            </LinearLayout>

            <!-- 栏间距 -->
            <View
                android:layout_width="18dp"
                android:layout_height="1dp" />

            <!-- ================= 右栏：准备项清单 + 按钮 ================= -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.tungsten.fcllibrary.component.view.FCLTextView
                    android:id="@+id/steps_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.85"
                    android:text="@string/dsh_setup_steps_header"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:auto_text_tint="true" />

                <LinearLayout
                    android:id="@+id/step_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/button_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.tungsten.fcllibrary.component.view.FCLButton
                        android:id="@+id/btn_logs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/dsh_setup_view_logs"
                        app:ripple="true" />

                    <com.tungsten.fcllibrary.component.view.FCLButton
                        android:id="@+id/btn_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:minWidth="0dp"
                        android:text="@string/dsh_action_retry"
                        android:visibility="gone"
                        app:ripple="true" />

                    <com.tungsten.fcllibrary.component.view.FCLButton
                        android:id="@+id/btn_restart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:minWidth="0dp"
                        android:text="@string/dsh_setup_restart"
                        app:ripple="true" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
