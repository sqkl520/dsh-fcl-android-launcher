<?xml version="1.0" encoding="utf-8"?>
<!--
  首启「准备运行环境」页（一次性前置）。

  ★ 横屏双栏：本 App 全程锁横屏（sensorLandscape），竖排长条内容在横屏下要滚动才能看全，
    所以按 FCL 的横屏习惯做成**左右两栏** ——
      左栏：品牌 + 提示 + 主进度卡（进度/步骤/明细，信息量最大）
      右栏：准备项清单 + 操作按钮
    两栏各自高度都控制在 ~330dp 以内，横屏一屏可见，无需滚动。

  视觉：主题背景图 + 压暗层 + 白卡片 + 主题色进度条；全部走 fcllibrary + ThemeEngine。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:transitionName="background">

    <ImageView
        android:id="@+id/bg_cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/bg_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 双栏容器：宽度用 padding 限制（平板/大屏不至于拉太宽） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="56dp"
            android:paddingTop="20dp"
            android:paddingEnd="56dp"
            android:paddingBottom="20dp">

            <!-- ================= 左栏：品牌 + 主进度卡 ================= -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.tungsten.fcllibrary.component.view.FCLTextView
                    android:id="@+id/app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dsh_setup_brand"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:auto_text_tint="true" />

                <com.tungsten.fcllibrary.component.view.FCLTextView
                    android:id="@+id/app_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.85"
                    android:text="@string/dsh_about_subtitle"
                    android:textSize="12sp"
                    app:auto_text_tint="true" />

                <com.tungsten.fcllibrary.component.view.FCLTextView
                    android:id="@+id/setup_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0.7"
                    android:text="@string/dsh_setup_hint_space"
                    android:textSize="11sp"
                    app:auto_text_tint="true" />

                <!-- 主进度卡 -->
                <com.tungsten.fcllibrary.component.view.FCLConstraintLayout
                    android:id="@+id/progress_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_container_white"
                    android:padding="16dp"
                    app:auto_tint="true">

                    <com.tungsten.fcllibrary.component.view.FCLImageView
                        android:id="@+id/state_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:padding="0dp"
                        android:src="@drawable/ic_baseline_download_24"
                        app:layout_constraintBottom_toBottomOf="@id/progress_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/progress_title"
                        app:use_theme_color="true" />

                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:id="@+id/progress_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:singleLine="true"
                        android:text="@string/dsh_setup_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:auto_text_tint="true"
                        app:layout_constraintEnd_toStartOf="@id/progress_percent"
                        app:layout_constraintStart_toEndOf="@id/state_icon"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:id="@+id/progress_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintBaseline_toBaselineOf="@id/progress_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:use_theme_color="true" />

                    <com.tungsten.fcllibrary.component.view.FCLProgressBar
                        android:id="@+id/progress_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:max="1000"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progress_title" />

                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:id="@+id/progress_stage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:maxLines="2"
                        android:textSize="13sp"
                        app:auto_text_tint="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progress_bar" />

                    <com.tungsten.fcllibrary.component.view.FCLTextView
                        android:id="@+id/progress_detail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:alpha="0.6"
                        android:ellipsize="middle"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:textSize="10sp"
                        android:visibility="gone"
                        app:auto_text_tint="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progress_stage" />

                </com.tungsten.fcllibrary.component.view.FCLConstraintLayout>
            </LinearLayout>

            <!-- 栏间距 -->
            <View
                android:layout_width="18dp"
                android:layout_height="1dp" />

            <!-- ================= 右栏：准备项清单 + 按钮 ================= -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.tungsten.fcllibrary.component.view.FCLTextView
                    android:id="@+id/steps_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.85"
                    android:text="@string/dsh_setup_steps_header"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:auto_text_tint="true" />

                <LinearLayout
                    android:id="@+id/step_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/button_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.tungsten.fcllibrary.component.view.FCLButton
                        android:id="@+id/btn_logs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/dsh_setup_view_logs"
                        app:ripple="true" />

                    <com.tungsten.fcllibrary.component.view.FCLButton
                        android:id="@+id/btn_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:minWidth="0dp"
                        android:text="@string/dsh_action_retry"
                        android:visibility="gone"
                        app:ripple="true" />

                    <com.tungsten.fcllibrary.component.view.FCLButton
                        android:id="@+id/btn_restart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:minWidth="0dp"
                        android:text="@string/dsh_setup_restart"
                        app:ripple="true" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
