<?xml version="1.0" encoding="utf-8"?>
<!--
  dsh 版本下载页。FCL 范式（见 §2.5）：页内不放大标题（页名由外壳动态岛显示），
  动作按钮用 FCLImageButton + android:src + anim_scale_large（照 FCL item_version.xml：
  FCLImageButton 自带 Ripple 按压涟漪，FIT_XY 自适应；1.5 倍按压缩放是 FCL 图标按钮的既定做法）。
  内容：顶部刷新按钮 + "显示预览版"开关 + 版本列表 + 加载/错误态。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp">

    <!-- 刷新：按 FCL 图标按钮规范（FCLImageView + background 图标 + padding 0 + use_theme_color） -->
    <com.tungsten.fcllibrary.component.view.FCLImageButton
        android:id="@+id/btn_refresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_baseline_refresh_24"
        android:stateListAnimator="@xml/anim_scale_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:auto_tint="true" />

    <com.tungsten.fcllibrary.component.view.FCLSwitch
        android:id="@+id/switch_prerelease"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:checked="true"
        android:text="@string/dsh_download_show_prerelease"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_refresh" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/version_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/switch_prerelease" />

    <com.tungsten.fcllibrary.component.view.FCLProgressBar
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/error_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#CC4444"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/switch_prerelease" />

</androidx.constraintlayout.widget.ConstraintLayout>
