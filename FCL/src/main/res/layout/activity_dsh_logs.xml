<?xml version="1.0" encoding="utf-8"?>
<!--
  dsh 运行/安装日志页 —— 控制台式日志视图。

  工具行**按 FCL 的图标按钮规范**写（见 FCL item_download_task.xml 的取消按钮）：
    图标按钮一律用 FCLImageView + `android:background=图标` + `padding=0dp` + `use_theme_color`，
    尺寸统一 28dp；**不设 stateListAnimator**（FCL 的页内图标按钮不设，按压缩放是列表卡片的做法）。
  文字（状态）用 FCLTextView，开关用 FCLSwitch（FCL 的开关行都是独占一行）。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp">

    <!-- ===== 工具行：状态（左） + 三个图标动作（右，统一 28dp） ===== -->
    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/runtime_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textSize="13sp"
        app:auto_text_tint="true"
        app:layout_constraintBottom_toBottomOf="@id/btn_filter"
        app:layout_constraintEnd_toStartOf="@id/btn_filter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_filter" />

    <com.tungsten.fcllibrary.component.view.FCLImageView
        android:id="@+id/btn_filter"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/ic_baseline_list_24"
        android:padding="0dp"
        app:layout_constraintEnd_toStartOf="@id/btn_copy"
        app:layout_constraintTop_toTopOf="parent"
        app:use_theme_color="true" />

    <com.tungsten.fcllibrary.component.view.FCLImageView
        android:id="@+id/btn_copy"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/ic_baseline_content_copy_24"
        android:padding="0dp"
        app:layout_constraintEnd_toStartOf="@id/btn_clear"
        app:layout_constraintTop_toTopOf="@id/btn_filter"
        app:use_theme_color="true" />

    <com.tungsten.fcllibrary.component.view.FCLImageView
        android:id="@+id/btn_clear"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/ic_baseline_delete_24"
        android:padding="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_filter"
        app:use_theme_color="true" />

    <!-- ===== 自动滚动（FCL 的开关行：独占一行、match_parent） ===== -->
    <com.tungsten.fcllibrary.component.view.FCLSwitch
        android:id="@+id/switch_auto_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:text="@string/dsh_logs_auto_scroll"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_filter" />

    <!-- ===== 控制台 ===== -->
    <ScrollView
        android:id="@+id/log_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_log_console"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/log_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/switch_auto_scroll">

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true"
            android:textSize="11sp" />

    </ScrollView>

    <!-- 回到底部（向上翻看历史时出现） -->
    <com.tungsten.fcllibrary.component.view.FCLButton
        android:id="@+id/btn_jump_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:minWidth="0dp"
        android:text="@string/dsh_logs_jump_bottom"
        android:textSize="12sp"
        android:visibility="gone"
        app:ripple="true"
        app:layout_constraintBottom_toBottomOf="@id/log_scroll"
        app:layout_constraintEnd_toEndOf="@id/log_scroll" />

    <!-- ===== 信息行 ===== -->
    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/log_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:textSize="10sp"
        android:alpha="0.7"
        app:auto_text_tint="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
