<?xml version="1.0" encoding="utf-8"?>
<!--
  dsh 运行/安装日志页 —— 控制台式日志视图。

  工具行按 FCL 的图标按钮规范写（照 FCL item_version.xml）：
    可点击的图标按钮用 **FCLImageButton + android:src + anim_scale_large + auto_tint**
    —— FCLImageButton 自带 Ripple 涟漪（颜色 ltColor）、setScaleType(FIT_XY)，1.5 倍按压缩放
    正是 FCL 图标按钮的既定做法（item_version / item_profile / item_remote_version 都这么写）。
  文字（状态）用 FCLTextView，开关用 FCLSwitch（FCL 的开关行都是独占一行）。

  页面左右留白 10dp：与侧边菜单、右面板、以及其余列表页同一档（FCL 列表左右留白就是 10dp）。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp">

    <!-- ===== 工具行：状态（左） + 三个图标动作（右，统一 28dp） ===== -->
    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/runtime_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textSize="13sp"
        app:auto_text_tint="true"
        app:layout_constraintBottom_toBottomOf="@id/btn_filter"
        app:layout_constraintEnd_toStartOf="@id/btn_filter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_filter" />

    <com.tungsten.fcllibrary.component.view.FCLImageButton
        android:id="@+id/btn_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_baseline_list_24"
        android:stateListAnimator="@xml/anim_scale_large"
        app:layout_constraintEnd_toStartOf="@id/btn_copy"
        app:layout_constraintTop_toTopOf="parent"
        app:auto_tint="true" />

    <com.tungsten.fcllibrary.component.view.FCLImageButton
        android:id="@+id/btn_copy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_baseline_content_copy_24"
        android:stateListAnimator="@xml/anim_scale_large"
        app:layout_constraintEnd_toStartOf="@id/btn_clear"
        app:layout_constraintTop_toTopOf="@id/btn_filter"
        app:auto_tint="true" />

    <com.tungsten.fcllibrary.component.view.FCLImageButton
        android:id="@+id/btn_clear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_baseline_delete_24"
        android:stateListAnimator="@xml/anim_scale_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_filter"
        app:auto_tint="true" />

    <!-- ===== 自动滚动（FCL 的开关行：独占一行、match_parent） ===== -->
    <com.tungsten.fcllibrary.component.view.FCLSwitch
        android:id="@+id/switch_auto_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:text="@string/dsh_logs_auto_scroll"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_filter" />

    <!-- ===== 控制台 ===== -->
    <ScrollView
        android:id="@+id/log_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_log_console"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/log_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/switch_auto_scroll">

        <!-- 日志正文。
             ⚠️ 这里**刻意不挂** `app:auto_text_tint`（那一族取的是"与用户主题色对比的黑/白"）：
             正文的底色是**中性**的日志底板（@color/dsh_log_console_bg，亮暗各一套），
             跟用户选的主题色没关系 —— 按主题色算出来的黑/白会与底板撞色（浅底配白字）。
             不挂属性时文字色走 AppCompat DayNight 主题默认（亮=深、暗=浅），
             与底板同为 DayNight 切换，天然对得上。
             另外每一行都会被 ForegroundColorSpan 按级别整体覆盖，基础色只作兜底。 -->
        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true"
            android:textSize="11sp" />

    </ScrollView>

    <!-- 回到底部（向上翻看历史时出现） -->
    <com.tungsten.fcllibrary.component.view.FCLButton
        android:id="@+id/btn_jump_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:minWidth="0dp"
        android:text="@string/dsh_logs_jump_bottom"
        android:textSize="12sp"
        android:visibility="gone"
        app:ripple="true"
        app:layout_constraintBottom_toBottomOf="@id/log_scroll"
        app:layout_constraintEnd_toEndOf="@id/log_scroll" />

    <!-- ===== 信息行 =====
         这一行压在**页面背景**上（和工具行的状态文字同一块底），所以取色用 `app:auto_text_tint`
         —— 与那一行同源，整页文字色才一致。

         ⚠️ 原来这里用 `android:alpha="0.7"` 代替弱化色：alpha 是对**整个控件**做透明，
         底板也会跟着变淡，看着像"这块背景没铺好"；而且它与同一块底上的其它文字不同源，
         主题一换两者就会分家。弱化该由**文字色**表达，不该由控件透明度表达。 -->
    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/log_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:textSize="10sp"
        app:auto_text_tint="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
