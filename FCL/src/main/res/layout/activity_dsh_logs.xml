<?xml version="1.0" encoding="utf-8"?>
<!--
  dsh 运行/安装日志控制台。FCL 范式（见 §2.5）：页内不放大标题（页名由外壳动态岛显示），
  动作按钮用 FCLImageButton（use_theme_color + no_padding + anim_scale_large）。
  内容：状态行 + 自动滚动开关 + 日志路径 + 滚动日志 + 顶部复制/清空图标。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp">

    <com.tungsten.fcllibrary.component.view.FCLImageButton
        android:id="@+id/btn_copy"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_baseline_content_copy_24"
        android:stateListAnimator="@xml/anim_scale_large"
        app:layout_constraintEnd_toStartOf="@id/btn_clear"
        app:layout_constraintTop_toTopOf="parent"
        app:no_padding="true"
        app:use_theme_color="true" />

    <com.tungsten.fcllibrary.component.view.FCLImageButton
        android:id="@+id/btn_clear"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_baseline_delete_24"
        android:stateListAnimator="@xml/anim_scale_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:no_padding="true"
        app:use_theme_color="true" />

    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/runtime_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:singleLine="true"
        android:textSize="13sp"
        app:auto_text_tint="true"
        app:layout_constraintEnd_toStartOf="@id/switch_auto_scroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_clear" />

    <com.tungsten.fcllibrary.component.view.FCLSwitch
        android:id="@+id/switch_auto_scroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/dsh_logs_auto_scroll"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/runtime_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/runtime_status" />

    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/log_path"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:textSize="11sp"
        app:auto_text_tint="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/runtime_status" />

    <ScrollView
        android:id="@+id/log_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="#11000000"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/log_path">

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textIsSelectable="true"
            app:auto_text_tint="true" />

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
