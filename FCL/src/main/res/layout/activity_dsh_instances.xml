<?xml version="1.0" encoding="utf-8"?>
<!-- dsh 实例列表页：标题栏（下载/日志入口）+ 运行时底座横幅 + 实例列表 + 空态提示
     FCL 风格（见 docs/design/app-shell.md §2.5）：纯 fcllibrary 控件，无 Material。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/dsh_instances_title"
        android:textSize="20sp"
        android:textStyle="bold"
        app:auto_text_tint="true"
        app:layout_constraintEnd_toStartOf="@id/btn_logs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.tungsten.fcllibrary.component.view.FCLButton
        android:id="@+id/btn_logs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="@string/dsh_action_logs"
        app:ripple="true"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toStartOf="@id/btn_download"
        app:layout_constraintTop_toTopOf="@id/title" />

    <com.tungsten.fcllibrary.component.view.FCLButton
        android:id="@+id/btn_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="@string/dsh_action_download"
        app:ripple="true"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/title" />

    <!-- 运行时底座未就绪时的横幅：就地把 proot/rootfs 解压好 -->
    <include
        android:id="@+id/bootstrap_banner"
        layout="@layout/view_dsh_bootstrap_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/instance_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bootstrap_banner" />

    <!-- 空态提示：无实例时显示 -->
    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/empty_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/dsh_instances_empty"
        android:visibility="gone"
        app:auto_text_tint="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bootstrap_banner" />

</androidx.constraintlayout.widget.ConstraintLayout>