<?xml version="1.0" encoding="utf-8"?>
<!--
  dsh 实例列表页。FCL 范式（见 docs/design/app-shell.md §2.5）：
  FCL 的页面**不在页内放标题、也不放页面级动作行** —— 页名由外壳底部的 FCLDynamicIsland 显示，
  页面切换/日志/下载等入口都在左侧菜单里，页内保持干净。
  内容：运行时底座横幅 + 实例列表 + 空态提示。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp">

    <!-- 运行时底座未就绪时的横幅：就地把 proot/rootfs 解压好，并显示解压进度 -->
    <include
        android:id="@+id/bootstrap_banner"
        layout="@layout/view_dsh_bootstrap_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/instance_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bootstrap_banner" />

    <!-- 空态提示：无实例时显示 -->
    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/empty_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/dsh_instances_empty"
        android:textSize="14sp"
        android:visibility="gone"
        app:auto_text_tint="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
