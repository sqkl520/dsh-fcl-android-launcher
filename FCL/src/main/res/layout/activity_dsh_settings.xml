<?xml version="1.0" encoding="utf-8"?>
<!-- dsh 实例设置页：API Key 录入/校验 + 实例名/模型/profile/端口 + 环境信息与维护操作。
     FCL 风格（见 §2.5）：FCLEditText + 上方 FCLTextView 当标签（不用 TextInputLayout），
     FCLSpinner / FCLButton / FCLTextView 自动跟随主题。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dsh_settings_title"
            android:textSize="20sp"
            android:textStyle="bold"
            app:auto_text_tint="true" />

        <!-- ===== API Key ===== -->
        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dsh_settings_section_key"
            android:textStyle="bold"
            app:auto_text_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/key_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            app:auto_text_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLEditText
            android:id="@+id/api_key_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/dsh_settings_key_hint"
            android:inputType="textPassword"
            android:singleLine="true"
            app:auto_edit_tint="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.tungsten.fcllibrary.component.view.FCLButton
                android:id="@+id/btn_save_key"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/dsh_action_save_key"
                app:ripple="true" />

            <com.tungsten.fcllibrary.component.view.FCLButton
                android:id="@+id/btn_test_key"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text="@string/dsh_action_test_key"
                app:ripple="true" />

            <com.tungsten.fcllibrary.component.view.FCLButton
                android:id="@+id/btn_clear_key"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text="@string/dsh_action_clear_key"
                app:ripple="true" />

        </LinearLayout>

        <!-- ===== 实例配置 ===== -->
        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/dsh_settings_section_instance"
            android:textStyle="bold"
            app:auto_text_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dsh_settings_name_hint"
            android:textSize="13sp"
            app:auto_text_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLEditText
            android:id="@+id/name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:inputType="text"
            android:singleLine="true"
            app:auto_edit_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dsh_settings_model"
            android:textSize="13sp"
            app:auto_text_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLSpinner
            android:id="@+id/model_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dsh_settings_profile"
            android:textSize="13sp"
            app:auto_text_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLSpinner
            android:id="@+id/profile_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dsh_settings_port_hint"
            android:textSize="13sp"
            app:auto_text_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLEditText
            android:id="@+id/port_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:inputType="number"
            android:singleLine="true"
            app:auto_edit_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLButton
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dsh_action_save"
            app:ripple="true" />

        <!-- ===== 运行环境信息 ===== -->
        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/dsh_settings_section_env"
            android:textStyle="bold"
            app:auto_text_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/version_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            app:auto_text_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/disk_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            app:auto_text_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/instance_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textIsSelectable="true"
            android:textSize="12sp"
            app:auto_text_tint="true" />

        <!-- ===== 维护操作 ===== -->
        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/dsh_settings_section_maintain"
            android:textStyle="bold"
            app:auto_text_tint="true" />

        <com.tungsten.fcllibrary.component.view.FCLButton
            android:id="@+id/btn_verify_runtime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dsh_action_verify_runtime"
            app:ripple="true" />

        <com.tungsten.fcllibrary.component.view.FCLButton
            android:id="@+id/btn_reinstall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dsh_action_reinstall"
            app:ripple="true" />

        <com.tungsten.fcllibrary.component.view.FCLButton
            android:id="@+id/btn_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dsh_action_logs"
            app:ripple="true" />

        <com.tungsten.fcllibrary.component.view.FCLButton
            android:id="@+id/btn_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dsh_action_delete"
            android:textColor="#CC4444"
            app:ripple="true" />

    </LinearLayout>
</ScrollView>
