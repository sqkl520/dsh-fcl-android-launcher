<?xml version="1.0" encoding="utf-8"?>
<!--
  设置行 —— **逐部件照搬** FCL 的 item_launcher_setting_button.xml：
    根：LinearLayoutCompat(vertical) + bg_item_rounded + paddingStart/End 12dp
      行：LinearLayoutCompat(horizontal) + minHeight 48dp + paddingTop/Bottom 8dp
          [label（FCLTextView，singleLine，垂直居中）] [weight=1 占位] [FCLButton(app:ripple)]
      描述：FCLTextView 12sp + marginBottom 8dp
  位置感知圆角（top/middle/bottom）与分组间距由适配器 + SpacingItemDecoration 负责，
  底色由适配器按主题色 tint（FCL 原版是纯白卡片；本项目主题色偏深，tint 后文字才看得清，
  与 FCL 的 auto_text_tint 取色逻辑一致）。

  ★ 底色既然是**代码**设的（bg_item_rounded* 的 solid 是白），适配器就必须同时向 ThemeEngine 注册
  刷新回调：只在新绑定时 tint 的话，主题切换后已经绑好的行会一直保持旧色（那就是本行看起来
  "没跟上换肤"的原因）。这一条在适配器的 applyRowBackground 里统一处理，布局这边不写死任何颜色。

  本行整行**不可点**（动作在右侧的 FCLButton 上，它自带 ripple + anim_scale 反馈），
  所以这里不挂 android:stateListAnimator —— 挂了也只会让"点空白处"有动静而实际什么也不做。
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_rounded"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:singleLine="true"
            app:auto_text_tint="true"
            tools:text="语言 / Language" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.tungsten.fcllibrary.component.view.FCLButton
            android:id="@+id/action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:minWidth="0dp"
            app:ripple="true"
            tools:text="打开" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textSize="12sp"
        app:auto_text_tint="true"
        tools:text="跟随系统语言" />

</androidx.appcompat.widget.LinearLayoutCompat>
