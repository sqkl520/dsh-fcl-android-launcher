<?xml version="1.0" encoding="utf-8"?>
<!-- 运行时底座未就绪横幅（include 到实例列表页）。
     改造前：底座没解压时界面毫无提示，用户点安装只会看到一句"请稍候"然后就失败。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#33FF9800"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/banner_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dsh_bootstrap_missing_short"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_prepare_runtime"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:minWidth="0dp"
            android:text="@string/dsh_action_prepare_runtime" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
