<?xml version="1.0" encoding="utf-8"?>
<!-- 运行时底座未就绪横幅（include 到实例列表页）。FCL 风格：FCLConstraintLayout 容器 + 橙色提示底。 -->
<com.tungsten.fcllibrary.component.view.FCLConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_container_white"
    android:padding="12dp"
    app:auto_tint="true">

    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/banner_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/dsh_bootstrap_missing_short"
        android:textSize="13sp"
        app:auto_text_tint="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.tungsten.fcllibrary.component.view.FCLButton
        android:id="@+id/btn_prepare_runtime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minWidth="0dp"
        android:text="@string/dsh_action_prepare_runtime"
        app:ripple="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/banner_text" />

</com.tungsten.fcllibrary.component.view.FCLConstraintLayout>
