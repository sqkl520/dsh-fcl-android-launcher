<?xml version="1.0" encoding="utf-8"?>
<!--
  运行时底座横幅（include 到实例列表页）。
  未就绪 → 提示 +「准备运行时」按钮；
  解压中 → 隐藏按钮、显示 FCL 进度条 + 阶段文案 + 明细（订阅 DshBootstrap.progress）。
  FCL 风格：FCLConstraintLayout + bg_container_white + auto_tint。
-->
<com.tungsten.fcllibrary.component.view.FCLConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_container_white"
    android:padding="12dp"
    app:auto_tint="true">

    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/banner_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/dsh_bootstrap_missing_short"
        android:textSize="13sp"
        app:auto_text_tint="true"
        app:layout_constraintEnd_toStartOf="@id/btn_prepare_runtime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.tungsten.fcllibrary.component.view.FCLButton
        android:id="@+id/btn_prepare_runtime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="@string/dsh_action_prepare_runtime"
        app:ripple="true"
        app:layout_constraintBottom_toBottomOf="@id/banner_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/banner_text" />

    <!-- 解压中：进度条 + 明细（平时 gone） -->
    <com.tungsten.fcllibrary.component.view.FCLProgressBar
        android:id="@+id/banner_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="1000"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/banner_text" />

    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/banner_detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:visibility="gone"
        app:auto_text_tint="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/banner_progress" />

</com.tungsten.fcllibrary.component.view.FCLConstraintLayout>
