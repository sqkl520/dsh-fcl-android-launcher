<?xml version="1.0" encoding="utf-8"?>
<!--
  「进行中任务」行 —— 照搬 FCL 的 item_download_task.xml：
    标题（12sp，主题色）+ 进度条（3dp）+ 右侧 28dp 图标按钮（FCLImageView + background 图标）
  用于首页顶部的任务区（解压运行环境 / 安装 dsh / 启动 / 删除）。
-->
<com.tungsten.fcllibrary.component.view.FCLConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/task_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textSize="13sp"
        app:auto_text_tint="true"
        app:layout_constraintEnd_toStartOf="@id/task_action"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="dsh 0.2.1-alpha.1 · 安装中…" />

    <com.tungsten.fcllibrary.component.view.FCLImageView
        android:id="@+id/task_action"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:padding="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/task_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/task_title"
        app:use_theme_color="true"
        tools:background="@drawable/ic_baseline_delete_24" />

    <com.tungsten.fcllibrary.component.view.FCLProgressBar
        android:id="@+id/task_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:max="1000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/task_title" />

    <com.tungsten.fcllibrary.component.view.FCLTextView
        android:id="@+id/task_detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:ellipsize="middle"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:textSize="10sp"
        android:visibility="gone"
        app:auto_text_tint="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/task_progress" />

</com.tungsten.fcllibrary.component.view.FCLConstraintLayout>
