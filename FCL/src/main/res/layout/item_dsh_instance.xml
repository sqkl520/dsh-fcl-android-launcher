<?xml version="1.0" encoding="utf-8"?>
<!--
  实例列表的一行 —— **照搬 FCL 的 item_profile.xml 范式**（实例列表 ↔ FCL 的「档案列表」是同一个位置）：
    外层 ConstraintLayout → 内层 clickable/focusable 容器
      background = @drawable/bg_container_white_clickable（白色可点击卡片，与下载页版本卡片一致）
      padding = 10dp，stateListAnimator = @xml/anim_scale（按压缩放反馈）
    文字用 FCLTextView + app:auto_text_tint（与卡片底自动对比）
  内容：名称 + 版本/端口/状态 + 体积 + 安装阶段/进度 + 失败原因 + 启动/更多。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_container_white_clickable"
        android:clickable="true"
        android:focusable="true"
        android:padding="10dp"
        android:stateListAnimator="@xml/anim_scale"
        app:auto_tint="true"
        app:layout_constraintTop_toTopOf="parent">

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btn_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:auto_text_tint="true"
            tools:text="dsh 0.1.5-rc.2" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textSize="11sp"
            app:layout_constraintEnd_toStartOf="@id/btn_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/name"
            app:auto_text_tint="true"
            tools:text="版本 0.1.5-rc.2 · 端口 3080 · 就绪" />

        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:textSize="11sp"
            app:layout_constraintEnd_toStartOf="@id/btn_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/subtitle"
            app:auto_text_tint="true"
            tools:text="312.4 MB" />

        <!-- 安装阶段文案（仅安装中可见） -->
        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/install_stage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/btn_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/size"
            app:auto_text_tint="true"
            tools:text="安装 @deepseek-ai/dsh@0.1.5-rc.2…" />

        <!-- FCL 的进度条形态：3dp 细条 + bg_progress_indeterminate 的动画 -->
        <com.tungsten.fcllibrary.component.view.FCLProgressBar
            android:id="@+id/install_progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:indeterminateDrawable="@drawable/bg_progress_indeterminate"
            android:max="100"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/install_stage" />

        <!-- 失败原因（BROKEN 时可见） -->
        <com.tungsten.fcllibrary.component.view.FCLTextView
            android:id="@+id/error_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#CC4444"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/install_progress"
            tools:text="npm install 失败：ETIMEDOUT" />

        <com.tungsten.fcllibrary.component.view.FCLButton
            android:id="@+id/btn_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/dsh_action_start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_more"
            app:layout_constraintTop_toTopOf="parent"
            app:ripple="true" />

        <com.tungsten.fcllibrary.component.view.FCLButton
            android:id="@+id/btn_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/dsh_action_more"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:ripple="true" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
