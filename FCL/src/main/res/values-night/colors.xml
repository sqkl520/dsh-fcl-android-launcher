<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="primary_text">#FFFFFF</color>
    <!-- 原 FCLLibrary 模块颜色（模块已并入 FCL） -->
    <color name="dialog_background">#232323</color>

    <!-- ===== 日志控制台（暗色）=====
         与 values/colors.xml 里的同名项一一对应；只覆盖这 6 个，其余颜色沿用默认值。
         暗色下底色换成深中性色，5 个分级色相应**提亮并降饱和** —— 把亮色那套深色值直接搬到暗底上
         会糊成一片（这正是旧实现"大量硬编码色 + 无法 night 覆盖"要解决的问题）。 -->
    <color name="dsh_log_console_bg">#232323</color>
    <color name="dsh_log_error">#FF8A80</color>
    <color name="dsh_log_warn">#FFCC80</color>
    <color name="dsh_log_ok">#A5D6A7</color>
    <color name="dsh_log_info">#D0D6DD</color>
    <color name="dsh_log_tag">#7DD3FC</color>
</resources>
