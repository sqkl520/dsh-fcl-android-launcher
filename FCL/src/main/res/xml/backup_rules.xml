<?xml version="1.0" encoding="utf-8"?><!--
  自动备份规则（Android 11 及以下；API 31+ 用 data_extraction_rules.xml）。

  ## 本次收紧（审查发现 P2）
  `<filesDir>/dsh/` 是 dsh 运行时目录，内含 rootfs（数百 MB）、npm 缓存、各实例的
  node_modules（每实例约 300MB）与运行日志。自动备份/云备份对单个 App 只有约 25MB 配额：
  - 备份它会瞬间撑爆配额（把别的 App 的数据挤掉），且上传体积巨大；
  - 恢复也没有意义：version 文件是按本机 assets 比对的，恢复后仍要重新解包；
    实例清单（instances.json）本身可由界面重建。
  因此整目录排除。API 密钥密文（instances/<id>/credentials.enc）也在其中：它用本机
  Keystore 主密钥加密，换机后本就解不开（界面会显示"无法解密"），排除反而避免误解。
-->
<full-backup-content>
    <exclude domain="file" path="dsh/" />
    <!-- ★ R49 S-15：WebView 的 cookie 库不在 dsh/ 下，而是 filesDir 的**兄弟目录** app_webview/。
         它存着 dsh 的会话 cookie（服务端有效期 30 天）—— 进了云备份/换机迁移就等于把
         一个仍有效的登录凭据复制到另一台设备。与 dsh/ 的排除理由不同：不是体积，是凭据。
         另外 app_textures / cache 之类没有备份价值，一并排除减少配额占用。 -->
    <exclude domain="file" path="app_webview/" />
    <exclude domain="file" path="app_textures/" />
    <exclude domain="database" path="webviewCookiesChromium.db" />
    <exclude domain="database" path="webviewCookiesChromiumNoPartition.db" />
</full-backup-content>
