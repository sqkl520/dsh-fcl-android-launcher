<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- [外壳改造] 已移除 Minecraft 专属权限与组件，只保留 dsh 启动器需要的。 -->

    <!-- 网络：npm registry 拉版本、DeepSeek 云端 API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 保活 dsh web 长驻进程 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ★ R49/S-13（F-4）：包可见性声明。
         没有它时（targetSdk=30+ 的默认行为），`resolveActivity` / `queryIntentActivities`
         对本 App **恒返回 null/空** —— 于是"我们把带 token 的 URL 交给了哪个 App"这件事
         在代码里**无法校验、也无法记录**（旧注释就写着"targetSdk=34 ⇒ resolveActivity 恒 null"）。
         外跳用的是隐式 `ACTION_VIEW`，接收方由系统挑，装了恶意 App 并注册 http(s) VIEW 的设备上
         一次"在浏览器中打开"就把活 token 交出去了（拿到即换 30 天 cookie）。

         这里只声明**外跳真正会用的那两种** intent（http / https 的 VIEW），
         不写 `<package>` 白名单、不开 `QUERY_ALL_PACKAGES` —— 可见面收到最小：
         本 App 只需要知道"谁能打开一个网页链接"。
         有了它之后 `externalBrowserIntent()` 才能①优先用 `CATEGORY_BROWSABLE` 收窄到浏览器，
         ②把实际接收方包名记进日志（排障与取证都要）。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name="com.tungsten.fcl.FCLApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoldCraftLauncher"
        tools:ignore="DiscouragedApi"
        tools:targetApi="33">

        <activity
            android:name="com.tungsten.fcl.activity.SplashActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Splash"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 首启「准备运行环境」页（一次性前置）：准备完成前不进主外壳 -->
        <activity
            android:name="com.dsh.ui.setup.DshSetupActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode"
            android:screenOrientation="sensorLandscape"
            tools:ignore="LockedOrientationActivity" />

        <!-- DeepSeek Harness (dsh) 启动器主外壳：左侧菜单 + ViewPager2 五页 + 右侧面板 -->
        <activity
            android:name="com.dsh.ui.shell.DshMainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            tools:ignore="LockedOrientationActivity" />

        <!-- dsh WebUI（独立 Activity：要整屏，且 dsh 自己管键盘/滚动，放外壳里反而互相干扰） -->
        <activity
            android:name="com.dsh.ui.DshWebViewActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- fcllibrary 崩溃上报（非 MC） -->
        <activity
            android:name="com.tungsten.fcllibrary.crash.CrashReportActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode"
            android:screenOrientation="sensorLandscape" />

        <!-- dsh 运行时前台服务：保活 dsh web 长驻进程。
             dataSync 在 Android 15 起有"每天累计 6 小时"的限制，对长时间挂着的 agent 是硬伤，
             因此同时声明 specialUse（API 34+ 运行时会优先用它）。 -->
        <service
            android:name="com.dsh.core.DshRuntimeService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a local AI agent server (dsh web) that the user started and can stop at any time." />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
        <provider
            android:name="com.tungsten.fcllibrary.crash.CrashReporterInitProvider"
            android:authorities="${applicationId}.crashreporterinitprovider"
            android:exported="false"
            android:initOrder="101" />
    </application>
</manifest>
