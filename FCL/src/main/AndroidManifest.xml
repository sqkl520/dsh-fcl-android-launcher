<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- [外壳改造] 已移除 Minecraft 专属权限与组件，只保留 dsh 启动器需要的。 -->

    <!-- 网络：npm registry 拉版本、DeepSeek 云端 API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 保活 dsh web 长驻进程 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name="com.tungsten.fcl.FCLApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoldCraftLauncher"
        tools:ignore="DiscouragedApi"
        tools:targetApi="33">

        <activity
            android:name="com.tungsten.fcl.activity.SplashActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Splash"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 首启「准备运行环境」页（一次性前置）：准备完成前不进主外壳 -->
        <activity
            android:name="com.dsh.ui.setup.DshSetupActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode"
            android:screenOrientation="sensorLandscape"
            tools:ignore="LockedOrientationActivity" />

        <!-- DeepSeek Harness (dsh) 启动器主外壳：左侧菜单 + ViewPager2 五页 + 右侧面板 -->
        <activity
            android:name="com.dsh.ui.shell.DshMainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            tools:ignore="LockedOrientationActivity" />

        <!-- dsh 详情页：实例设置 / WebView（均经 DshMainActivity 的 singleTop 复用外壳实例） -->
        <activity
            android:name="com.dsh.ui.DshSettingsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity" />
        <activity
            android:name="com.dsh.ui.DshWebViewActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- fcllibrary 崩溃上报（非 MC） -->
        <activity
            android:name="com.tungsten.fcllibrary.crash.CrashReportActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode"
            android:screenOrientation="sensorLandscape" />

        <!-- dsh 运行时前台服务：保活 dsh web 长驻进程。
             dataSync 在 Android 15 起有"每天累计 6 小时"的限制，对长时间挂着的 agent 是硬伤，
             因此同时声明 specialUse（API 34+ 运行时会优先用它）。 -->
        <service
            android:name="com.dsh.core.DshRuntimeService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a local AI agent server (dsh web) that the user started and can stop at any time." />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
        <provider
            android:name="com.tungsten.fcllibrary.crash.CrashReporterInitProvider"
            android:authorities="${applicationId}.crashreporterinitprovider"
            android:exported="false"
            android:initOrder="101" />
    </application>
</manifest>
