# ============================================================
# 忽略规则
# ============================================================

# ---- 构建产物 / 编辑器缓存（可重建） ----
build/
.gradle/
.kotlin/
.cxx/
.idea/
*.iml
local.properties

# ---- 大文件：超 GitHub 单文件 100MB 限制，且都能重建 ----
*.apk
!*.apk.part*
*.tar.xz

# ---- 依赖目录 ----
node_modules/

# ---- 交付 / 取件目录（本机） ----
/output/

# ---- 日志与系统垃圾 ----
*.log
*.hprof
.DS_Store
google-services.json

# ---- 沙箱存储实体（软链环，跨环境复制会毁数据） ----
.l2s.*


# ---- 手机：嵌套的源码仓 clone ----
/dsh-fcl-android-launcher/

# ---- 源工程内的本地大文件 / 生成物 ----
FCL/src/main/assets/dsh/rootfs/rootfs.tar.xz
FCL/src/main/java/com/mio/Main.kt

# ---- FCL 遗留 ----
.trae/
/.zcode/
.zcodeignore
AGENTS.md
