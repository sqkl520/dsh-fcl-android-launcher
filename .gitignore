# ============================================================
# 忽略规则
# ============================================================

# ---- 构建产物 / 编辑器缓存（可重建） ----
build/
.gradle/
.kotlin/
.cxx/
.idea/
*.iml
local.properties

# ---- ★ 签名私钥：永远不进版本控制 ----
#
# R49 BUILD 审查的 🔴：`release-key/` 原先只写在 `.git/info/exclude` 里，
# 而那个文件**在 .git 内部、不受版本控制** —— 新机器 clone 下来它是空的。
# 实测复现：fresh clone 后把 release-key/ 放回工作区，`git add -A --dry-run`
# 第一行就是 `add 'release-key/dsh-release.jks'`，即**私钥会被提交到公开仓**。
#
# 所以必须在 .gitignore（受版本控制、每个 clone 都带）里再写一遍。
# 这是唯一能保证"任何机器上都不会误提交私钥"的位置。
/release-key/
*.jks
*.keystore
dsh.pwd

# ---- 大文件：超 GitHub 单文件 100MB 限制，且都能重建 ----
*.apk
!*.apk.part*
*.tar.xz

# ---- 依赖目录 ----
node_modules/

# ---- 交付 / 取件目录（本机） ----
/output/

# ---- 日志与系统垃圾 ----
*.log
*.hprof
.DS_Store
google-services.json

# ---- 沙箱存储实体（软链环，跨环境复制会毁数据） ----
.l2s.*


# ---- 手机：嵌套的源码仓 clone ----
/dsh-fcl-android-launcher/

# ---- 源工程内的本地大文件 / 生成物 ----
FCL/src/main/assets/dsh/rootfs/rootfs.tar.xz
FCL/src/main/java/com/mio/Main.kt

# ---- FCL 遗留 ----
.trae/
/.zcode/
.zcodeignore
AGENTS.md

# ---- 本地工具产物（不进仓库）----
# Honor Suite 安装包 45MB + 从 Google 下的 USB 驱动，都是"装机用的一次性下载物"，
# 需要时按 tools/honor-adb/README.md 重新下载即可。
tools/honor-adb/*.exe
tools/honor-adb/amd64/
tools/honor-adb/i386/
tools/honor-adb/android_winusb.inf
tools/honor-adb/androidwinusb*.cat
tools/honor-adb/source.properties
