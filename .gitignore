# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# APK 归档默认不提交二进制，但保留归档说明与校验文件
apk-archive/**/*.apk
!apk-archive/**/SHA256SUMS
!apk-archive/README.md

# IntelliJ
*.iml
.idea/
.trae/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof
FCL/src/main/java/com/mio/Main.kt
.DS_Store
AGENTS.md

# ZCode 会话文件
/.zcode/
.kotlin/
.zcodeignore
# 本地预打包 Debian rootfs（约 279MB），用于 APK 打包，不提交 Git
FCL/src/main/assets/dsh/rootfs/rootfs.tar.xz
